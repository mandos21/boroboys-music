APP_ENV=development
APP_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://music_rounds:music_rounds@localhost:5432/music_rounds
PROCRASTINATE_DATABASE_URL=postgresql://music_rounds:music_rounds@localhost:5432/music_rounds
SESSION_SECRET=replace-with-a-long-random-value
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-compatible-key
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1

OIDC_ISSUER_URL=https://id.example.net/realms/music-rounds
OIDC_CLIENT_ID=music-rounds
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_SCOPES=openid profile email
OIDC_AUTO_PROVISION_USERS=true
# The first provisioned user on an empty database becomes the platform admin.
OIDC_BOOTSTRAP_FIRST_USER_ADMIN=true
OIDC_REQUIRE_VERIFIED_EMAIL=false
OIDC_POST_LOGOUT_REDIRECT_URL=http://localhost:5173/signed-out
# Optional advanced administrator mappings. They are not needed for initial setup.
# Comma-separated immutable OIDC subject IDs used to bootstrap platform admins.
OIDC_BOOTSTRAP_ADMIN_SUBJECTS=
OIDC_ADMIN_CLAIM=
OIDC_ADMIN_VALUES=
SESSION_COOKIE_NAME=music_rounds_session
SESSION_LIFETIME_HOURS=168

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/v1/connections/spotify/callback
LASTFM_API_KEY=
LASTFM_EVIDENCE_REFRESH_HOURS=24
LASTFM_SHARED_SECRET=
LASTFM_CALLBACK_URL=http://localhost:8000/api/v1/connections/lastfm/callback
